{
	"name": "obsidian-safe-js-plugin",
	"version": "0.3.2",
	"description": "Run JavaScript in Obsidian through sandboxed Web Workers and a limited RPC surface.",
	"main": "main.js",
	"scripts": {
		"deps:init": "bun install && bun --cwd=packages/safe-js-api install",
		"dev": "vite build --mode=development --watch",
		"build": "vite build --mode=production",
		"api:build": "bun --cwd=packages/safe-js-api run build",
		"api:typecheck": "bun --cwd=packages/safe-js-api run typecheck && tsc --noEmit -p test/fixtures/safe-js-api-consumer/tsconfig.json",
		"typecheck": "tsc --noEmit --skipLibCheck",
		"test": "LOG_TESTS=false bun test",
		"test:log": "LOG_TESTS=true bun test",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . --report-unused-disable-directives --suppressions-location eslint-ci-suppressions.json",
		"lint:fix": "eslint . --fix --report-unused-disable-directives --suppressions-location eslint-ci-suppressions.json",
		"check": "bun run format:check && bun run typecheck && bun run typecheck:tools && bun run api:typecheck && bun run lint && bun run test",
		"release": "lemons-automation release",
		"lint:review": "eslint . --config eslint.review.config.mjs",
		"verify": "bun run check && bun run build && bun run api:pack && lemons-automation validate",
		"package": "bun run build && bun run api:pack && lemons-automation package",
		"api:pack": "bun run api:build && bun --cwd=packages/safe-js-api pm pack --filename ../../dist/obsidian-safe-js-api.tgz",
		"typecheck:tools": "tsc --noEmit -p tsconfig.tools.json"
	},
	"keywords": [],
	"author": "Moritz Jung",
	"license": "GPL-3.0",
	"devDependencies": {
		"@happy-dom/global-registrator": "^20.9.0",
		"@lemons_dev/lemons-obsidian-plugin-automation": "https://github.com/mProjectsCode/lemons-obsidian-plugin-helpers/releases/download/automation-v0.2.9/automation-v0.2.9.tgz",
		"@types/bun": "1.3.14",
		"eslint": "9.39.4",
		"obsidian": "latest",
		"prettier": "3.9.4",
		"tslib": "^2.8.1",
		"typescript": "6.0.3",
		"vite": "8.1.3",
		"@lemons_dev/eslint-config-obsidian": "https://github.com/mProjectsCode/lemons-obsidian-plugin-helpers/releases/download/eslint-config-v0.1.5/eslint-config-v0.1.5.tgz",
		"@types/node": "25.5.0"
	},
	"dependencies": {
		"@babel/helper-validator-identifier": "^8.0.2",
		"ses": "^2.1.0",
		"temporal-polyfill": "1.0.1",
		"zod": "^4.4.3"
	},
	"packageManager": "bun@1.4.0",
	"overrides": {
		"typescript": "6.0.3",
		"typescript-eslint": "8.61.1"
	}
}
